{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guardian-coder/reality/prototype/schemas/cea.schema.json",
  "title": "Claim-Evidence-Action Contract",
  "type": "object",
  "required": ["contract", "claims", "disposition_policy"],
  "properties": {
    "contract": { "$ref": "#/$defs/ActionContract" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ClaimRequirement" }
    },
    "disposition_policy": { "$ref": "#/$defs/DispositionPolicy" }
  },
  "additionalProperties": false,
  "$defs": {
    "EpistemicState": {
      "type": "string",
      "enum": ["CONFIRMED", "CONTRADICTED", "UNKNOWN"]
    },
    "Disposition": {
      "type": "string",
      "enum": ["PERMIT", "DEGRADE", "REVALIDATE", "HUMAN_REVIEW", "REFUSE"]
    },
    "ActionContract": {
      "type": "object",
      "required": ["contract_id", "version", "action_type", "asset_id", "subject_id"],
      "properties": {
        "contract_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "action_type": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ValuePredicate": {
      "type": "object",
      "required": ["field", "operator", "value"],
      "properties": {
        "field": { "type": "string", "enum": ["value"] },
        "operator": { "type": "string", "enum": ["equals", "not_equals"] },
        "value": {}
      },
      "additionalProperties": false
    },
    "EvidenceRule": {
      "type": "object",
      "required": ["evidence_type", "minimum_count"],
      "properties": {
        "evidence_type": { "type": "string", "minLength": 1 },
        "minimum_count": { "type": "integer", "minimum": 0 },
        "maximum_age_seconds": { "type": "integer", "minimum": 0 },
        "required_integrity_status": { "type": "string", "enum": ["VERIFIED"] },
        "confirms_when": { "$ref": "#/$defs/ValuePredicate" },
        "contradicts_when": { "$ref": "#/$defs/ValuePredicate" }
      },
      "additionalProperties": false
    },
    "ClaimRequirement": {
      "type": "object",
      "required": ["claim_id", "statement", "required_state", "evidence_rules", "minimum_independent_lineages"],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^C-[0-9]{2}$" },
        "statement": { "type": "string", "minLength": 1 },
        "required_state": { "$ref": "#/$defs/EpistemicState" },
        "subject_entity_id": { "type": "string", "minLength": 1 },
        "evidence_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceRule" }
        },
        "contradiction_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceRule" }
        },
        "minimum_independent_lineages": { "type": "integer", "minimum": 0 },
        "contradiction_policy": { "type": "string", "enum": ["REFUSE", "HUMAN_REVIEW"] }
      },
      "additionalProperties": false
    },
    "EvidenceRecord": {
      "type": "object",
      "required": ["evidence_id", "source_id", "observed_entity_id", "observation_time", "received_time", "valid_until", "claim_ids", "evidence_type", "value", "uncertainty", "parent_evidence_ids", "failure_domains", "integrity_status"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "observed_entity_id": { "type": "string", "minLength": 1 },
        "observation_time": { "type": "string", "format": "date-time" },
        "received_time": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidence_type": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "boolean", "object", "array", "null"] },
        "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
        "parent_evidence_ids": { "type": "array", "items": { "type": "string" } },
        "failure_domains": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "integrity_status": { "type": "string", "enum": ["VERIFIED", "FAILED", "UNKNOWN"] },
        "stance": { "type": "string", "enum": ["SUPPORTS", "CONTRADICTS"] }
      },
      "additionalProperties": false
    },
    "DependencyGraph": {
      "type": "object",
      "required": ["lineages", "shared_failure_domains"],
      "properties": {
        "lineages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["root_evidence_id", "descendant_evidence_ids"],
            "properties": {
              "root_evidence_id": { "type": "string" },
              "descendant_evidence_ids": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "shared_failure_domains": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      },
      "additionalProperties": false
    },
    "ClaimEvaluation": {
      "type": "object",
      "required": ["claim_id", "state", "effective_independent_lineages", "supporting_evidence_ids", "contradicting_evidence_ids", "reasons"],
      "properties": {
        "claim_id": { "type": "string" },
        "state": { "$ref": "#/$defs/EpistemicState" },
        "effective_independent_lineages": { "type": "integer", "minimum": 0 },
        "supporting_evidence_ids": { "type": "array", "items": { "type": "string" } },
        "contradicting_evidence_ids": { "type": "array", "items": { "type": "string" } },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "CrossClaimDependency": {
      "type": "object",
      "required": ["failure_domain", "claim_ids"],
      "properties": {
        "failure_domain": { "type": "string" },
        "claim_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ActionDisposition": {
      "type": "object",
      "required": ["action_id", "disposition", "claim_evaluations", "reason_codes"],
      "properties": {
        "action_id": { "type": "string" },
        "disposition": { "$ref": "#/$defs/Disposition" },
        "claim_evaluations": { "type": "array", "items": { "$ref": "#/$defs/ClaimEvaluation" } },
        "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cross_claim_dependencies": { "type": "array", "items": { "$ref": "#/$defs/CrossClaimDependency" } }
      },
      "additionalProperties": false
    },
    "DispositionPolicy": {
      "type": "object",
      "required": ["all_required_confirmed", "unknown_resolvable", "unresolved_conflict", "critical_contradiction", "integrity_failure"],
      "properties": {
        "all_required_confirmed": { "const": "PERMIT" },
        "unknown_resolvable": { "const": "REVALIDATE" },
        "unresolved_conflict": { "const": "HUMAN_REVIEW" },
        "critical_contradiction": { "const": "REFUSE" },
        "integrity_failure": { "const": "REFUSE" }
      },
      "additionalProperties": false
    }
  }
}

